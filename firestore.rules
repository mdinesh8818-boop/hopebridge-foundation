rules_version = '2';

// HopeBridge — multi-organization SaaS access control
// Deploy with Firebase CLI or Console after merge. Not applied automatically by Vercel.
//
// Model:
// - Firebase Auth proves identity
// - userProfiles/{uid} proves membership + status + role + organizationId
// - Operational data requires active status AND matching organizationId
// - Legacy HopeBridge docs without organizationId are readable/writable only by
//   active hopebridge members during migration (soft-tag to organizationId=hopebridge)
// - Preserves PR #15 bootstrap admin promotion for mdinesh8818@gmail.com

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hopebridgeOrgId() {
      return "hopebridge";
    }

    function profilePath() {
      return /databases/$(database)/documents/userProfiles/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function isActiveMember() {
      return hasProfile()
        && profile().status == "active"
        && profile().organizationId is string
        && profile().organizationId.size() > 0;
    }

    function memberOrgId() {
      return profile().organizationId;
    }

    function isAdmin() {
      return isActiveMember() && profile().role == "admin";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function accessControlMetaPath() {
      return /databases/$(database)/documents/appMetadata/accessControl;
    }

    function hasAccessControlMeta() {
      return exists(accessControlMetaPath());
    }

    function bootstrapAdminEmails() {
      return hasAccessControlMeta()
        ? get(accessControlMetaPath()).data.get("bootstrapAdminEmails", [])
        : [];
    }

    // Keep in sync with DEFAULT_BOOTSTRAP_ADMIN_EMAILS in src/lib/accessControl.ts
    function isKnownBootstrapAdminEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == "mdinesh8818@gmail.com";
    }

    function isBootstrapAdminEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && (
          isKnownBootstrapAdminEmail()
          || request.auth.token.email.lower() in bootstrapAdminEmails()
        );
    }

    function validRole(role) {
      return role in ["admin", "manager", "member"];
    }

    function validStatus(status) {
      return status in ["pending", "active", "disabled"];
    }

    function pendingSelfCreate() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.get("organizationId", "") == ""
        && request.resource.data.role == "member"
        && request.resource.data.status == "pending"
        && request.resource.data.get("onboardingComplete", false) == false;
    }

    function legacyActiveSelfCreate() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.organizationId == hopebridgeOrgId()
        && validRole(request.resource.data.role)
        && request.resource.data.status == "active"
        && request.resource.data.legacyBackfill == true
        && request.resource.data.get("onboardingComplete", true) == true
        && (
          exists(/databases/$(database)/documents/userSettings/$(request.auth.uid))
          || isBootstrapAdminEmail()
        )
        && (
          request.resource.data.role != "admin"
          || isBootstrapAdminEmail()
        );
    }

    // Allows the known bootstrap admin to elevate a stale active/member
    // (or pending/empty-org) profile to active/admin on the hopebridge tenant.
    function bootstrapSelfAdminPromote(userId) {
      return isOwner(userId)
        && isBootstrapAdminEmail()
        && (
          resource.data.get("organizationId", "") == ""
          || resource.data.organizationId == hopebridgeOrgId()
        )
        && request.resource.data.organizationId == hopebridgeOrgId()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == "admin"
        && request.resource.data.status == "active"
        && request.resource.data.get("onboardingComplete", true) == true
        && validRole(request.resource.data.role)
        && validStatus(request.resource.data.status);
    }

    // Self-serve nonprofit onboarding completion (create own org as active admin).
    function onboardingActivationUpdate() {
      return isOwner(request.auth.uid)
        && resource.data.status == "pending"
        && resource.data.get("organizationId", "") == ""
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.status == "active"
        && request.resource.data.role == "admin"
        && request.resource.data.organizationId is string
        && request.resource.data.organizationId.size() > 0
        && request.resource.data.onboardingComplete == true
        && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId))
        && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.createdBy == request.auth.uid;
    }

    // Mark "join existing org" without granting data access.
    function awaitInviteUpdate() {
      return isOwner(request.auth.uid)
        && resource.data.status == "pending"
        && resource.data.get("organizationId", "") == ""
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.status == "pending"
        && request.resource.data.role == resource.data.role
        && request.resource.data.get("organizationId", "") == ""
        && request.resource.data.onboardingComplete == true;
    }

    // Resume create-organization onboarding from the pending screen.
    function resumeOnboardingUpdate() {
      return isOwner(request.auth.uid)
        && resource.data.status == "pending"
        && resource.data.get("organizationId", "") == ""
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.status == "pending"
        && request.resource.data.role == resource.data.role
        && request.resource.data.get("organizationId", "") == ""
        && request.resource.data.onboardingComplete == false;
    }

    function protectedFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.get("approvedAt", null) == resource.data.get("approvedAt", null)
        && request.resource.data.get("approvedBy", null) == resource.data.get("approvedBy", null)
        && request.resource.data.get("disabledAt", null) == resource.data.get("disabledAt", null)
        && request.resource.data.get("disabledBy", null) == resource.data.get("disabledBy", null)
        && request.resource.data.get("legacyBackfill", false) == resource.data.get("legacyBackfill", false)
        && request.resource.data.get("onboardingComplete", false) == resource.data.get("onboardingComplete", false);
    }

    function docOrgId() {
      return resource.data.get("organizationId", "");
    }

    function writeOrgId() {
      return request.resource.data.get("organizationId", "");
    }

    // Same-org match, or legacy untagged HopeBridge Foundation docs.
    function canAccessOrgDoc() {
      return isActiveMember() && (
        docOrgId() == memberOrgId()
        || (docOrgId() == "" && memberOrgId() == hopebridgeOrgId())
      );
    }

    function canWriteOrgDoc() {
      return isActiveMember()
        && writeOrgId() == memberOrgId()
        && (
          !resource.keys().hasAll(["organizationId"])
          || docOrgId() == ""
          || docOrgId() == memberOrgId()
        );
    }

    function canCreateOrgDoc() {
      return isActiveMember() && writeOrgId() == memberOrgId();
    }

    // --- Access control ---

    match /userProfiles/{userId} {
      allow get: if isOwner(userId)
        || (isAdmin() && resource.data.organizationId == memberOrgId())
        || (isAdmin() && resource.data.get("organizationId", "") == ""
            && resource.data.status == "pending");
      allow list: if isAdmin() && (
        resource.data.organizationId == memberOrgId()
        || (resource.data.get("organizationId", "") == ""
            && resource.data.status == "pending")
      );
      allow create: if isOwner(userId)
        && (pendingSelfCreate() || legacyActiveSelfCreate());
      allow update: if (isOwner(userId) && protectedFieldsUnchanged())
        || bootstrapSelfAdminPromote(userId)
        || onboardingActivationUpdate()
        || awaitInviteUpdate()
        || resumeOnboardingUpdate()
        || (isAdmin()
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.organizationId == memberOrgId()
            && (resource.data.get("organizationId", "") == ""
                || resource.data.organizationId == memberOrgId())
            && validRole(request.resource.data.role)
            && validStatus(request.resource.data.status));
      allow delete: if false;
    }

    match /userSettings/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create, update, delete: if isOwner(userId) && isActiveMember();
    }

    match /appMetadata/{docId} {
      allow get: if isSignedIn() && docId == "accessControl";
      allow get: if isActiveMember();
      allow list: if isAdmin();
      // Platform metadata writes: HopeBridge Foundation admins only
      allow create, update: if isAdmin() && memberOrgId() == hopebridgeOrgId();
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow get: if isSignedIn() && (
        (isActiveMember() && orgId == memberOrgId())
        || (hasProfile() && resource.data.createdBy == request.auth.uid)
      );
      allow list: if false;
      allow create: if isSignedIn()
        && hasProfile()
        && profile().status in ["pending", "active"]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if isAdmin() && orgId == memberOrgId();
      allow delete: if false;
    }

    match /organizationProfile/{docId} {
      allow get, list: if canAccessOrgDoc()
        || (isActiveMember()
            && memberOrgId() == hopebridgeOrgId()
            && docId == "foundation");
      allow create: if canCreateOrgDoc() && isAdmin();
      allow update: if canWriteOrgDoc() && isAdmin();
      allow delete: if false;
    }

    // --- Operational collections (active members of matching organization) ---

    match /campaigns/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /programs/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /donors/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /donations/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /volunteers/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /beneficiaries/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /beneficiaryActivity/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /teams/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /teamMembers/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /teamAssignments/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /teamDiscussions/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /teamMeetings/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /teamActivity/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /activities/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /missionVision/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /coreValues/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
    match /strategicGoals/{id} {
      allow read: if canAccessOrgDoc();
      allow create: if canCreateOrgDoc();
      allow update, delete: if canWriteOrgDoc();
    }
  }
}
