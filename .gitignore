# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor / native local build artifacts (source projects are committed)
android/.gradle/
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/build/
ios/App/build/
ios/App/Pods/
ios/DerivedData/
*.xcuserdata/
